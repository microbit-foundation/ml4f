{
  "compilerOptions": {
    "moduleResolution": "nodenext",
    "target": "es2017",
    "module": "nodenext",
    "lib": ["es2022"],
    "strict": false,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "preserveConstEnums": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "outDir": "built",
    "rootDir": "src",
    "newLine": "LF",
    "types": ["node"]
  },
  "include": [ "src" ]
}
